menu "Johan2 Player Configuration"
    config JOHAN2_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
    config JOHAN2_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
    config JOHAN2_PLAYER_NAME
        string "Name shown in Music Assistant"
        default "Johan2 AUX"
    config JOHAN2_SERVER_URL
        string "Optional Sendspin WebSocket URL (blank for discovery)"
        default ""
        help
            Optional ws://HOST:8928/sendspin URL. Normally Music Assistant
            discovers this player through mDNS and connects to it.
    config JOHAN2_INITIAL_VOLUME
        int "Initial volume (percent)"
        range 0 100
        default 35
    config JOHAN2_I2S_BCLK
        int "PCM5102A BCLK GPIO"
        range 0 48
        default 6
    config JOHAN2_I2S_LRCK
        int "PCM5102A LRCK GPIO"
        range 0 48
        default 5
    config JOHAN2_I2S_DOUT
        int "PCM5102A DIN GPIO"
        range 0 48
        default 4
    config JOHAN2_LED_GPIO
        int "Onboard addressable RGB LED GPIO (-1 disables)"
        range -1 48
        default 48
        help
            ESP32-S3-DevKitC-1 v1.0 uses GPIO48, v1.1 uses GPIO38.
    config JOHAN2_HA_WS_URL
        string "Home Assistant WebSocket URL"
        default "ws://haos.home:8123/api/websocket"
    config JOHAN2_HA_TOKEN
        string "Home Assistant long-lived access token (local sdkconfig only)"
        default ""
        help
            Leave blank to disable Assist. Never commit or log this credential.
    config JOHAN2_HA_PIPELINE
        string "Assist pipeline ID (blank uses preferred assistant)"
        default ""
    config JOHAN2_HA_REPLY_PLAYER
        string "HA media_player entity for spoken replies (blank disables)"
        default ""
        help
            Set the Music Assistant media_player entity for this Johan2 AUX player.
            Assist generates TTS and forwards it as an announcement via Music Assistant.
    config JOHAN2_TTS_DIRECT
        bool "Play spoken replies directly on this device"
        default y
        help
            Fetch the HA TTS WAV and play it through the DAC, mixed over music.
            Non-WAV replies fall back to the reply media_player, if set.
    config JOHAN2_TTS_VOLUME
        int "Direct reply volume (percent)"
        range 0 100
        default 70
    config JOHAN2_HOMEDASH_TRANSCRIPT_URL
        string "HomeDash proxy URL to show what Assist heard (blank disables)"
        default ""
        help
            Example: http://bakkieplus:8767/transcript. The HomeDash proxy shows
            the recognised text on its wall display.
    config JOHAN2_MIC_GAIN
        int "Microphone PCM gain for Assist"
        range 1 32
        default 16
    config JOHAN2_MIC_AUTO_GAIN
        bool "Automatically control microphone gain before PCM clipping"
        default n
        help
            Fast peak protection and slow gain recovery after noise suppression.
            MIC_GAIN is the startup/quiet baseline. Below the activity threshold
            gain returns only to this baseline, not the maximum.
    config JOHAN2_MIC_MAX_GAIN
        int "Maximum automatic microphone gain"
        range 1 32
        default 16
        help
            Upper gain limit when automatic gain is enabled; ignored otherwise.
    config JOHAN2_MIC_HIGHPASS_HZ
        int "Microphone rumble high-pass cutoff (Hz; 0 disables)"
        range 0 300
        default 100
        help
            Second-order Butterworth high-pass before Assist gain/clipping.
            100 Hz suppresses low rumble. 0 retains the original DC removal.
    config JOHAN2_MIC_PROFILE_DENOISE
        bool "Enable Johan2 measured-profile microphone noise suppression"
        default n
        help
            Experimental spectral suppression derived from noisy/quiet recordings.
            Adds 32 ms fixed latency and uses about 20 KB fixed RAM.
            Operates before gain/clipping; disable for unprocessed comparison.
    config JOHAN2_MIC_DIAGNOSTICS
        bool "Enable on-demand microphone WAV recording on HTTP port 8081"
        default n
        help
            GET /mic.wav records 15 seconds of Assist-input PCM in PSRAM.
            No authentication: enable temporarily on a trusted LAN only.
            Audio is erased after download; no flash storage is used.
endmenu
