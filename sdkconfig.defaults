CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_SENDSPIN_ENABLE_PLAYER=y
# CONFIG_SENDSPIN_ENABLE_CONTROLLER is not set
# CONFIG_SENDSPIN_ENABLE_METADATA is not set
# CONFIG_SENDSPIN_ENABLE_COLOR is not set
# CONFIG_SENDSPIN_ENABLE_ARTWORK is not set
# CONFIG_SENDSPIN_ENABLE_VISUALIZER is not set

# Restore the scheduler rate used by the working 0.2.0 firmware.
CONFIG_FREERTOS_HZ=100
